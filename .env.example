NEXT_PUBLIC_API_URL=https://api.example.com/v1

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- NextAuth (Auth.js v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Required when self-hosting behind a proxy / not on Vercel
AUTH_TRUST_HOST=true

# Optional dev-only demo login (ignored in production)
AUTH_DEMO_EMAIL=demo@example.com
AUTH_DEMO_PASSWORD=password123
